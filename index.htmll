
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>REVOLTé - Expérience bancaire</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }
        
        body {
            background-color: #0c0e29;
            color: white;
            overflow-x: hidden;
            height: 100vh;
            position: relative;
        }
        
        .container {
            max-width: 500px;
            margin: 0 auto;
            height: 100vh;
            position: relative;
            overflow: hidden;
        }
        
        /* Écran de chargement avec bulle */
        .loading-screen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #0c0e29 0%, #1a1d4e 100%);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            transition: opacity 0.8s ease;
        }
        
        .app-bubble {
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: linear-gradient(135deg, #5d00ff 0%, #8a2be2 100%);
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(93, 0, 255, 0.4);
            animation: pulse 2s infinite alternate;
        }
        
        @keyframes pulse {
            from { transform: scale(1); box-shadow: 0 10px 30px rgba(93, 0, 255, 0.4); }
            to { transform: scale(1.05); box-shadow: 0 15px 40px rgba(93, 0, 255, 0.6); }
        }
        
        .app-name {
            font-size: 2.8rem;
            font-weight: 800;
            background: linear-gradient(90deg, #ff3366, #ff9933);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            text-align: center;
        }
        
        .tagline {
            font-size: 1.2rem;
            color: #a0a5d6;
            text-align: center;
            margin-top: 10px;
            font-weight: 300;
        }
        
        .loading-text {
            margin-top: 30px;
            font-size: 1rem;
            color: #8a8fc3;
            animation: blink 1.5s infinite;
        }
        
        @keyframes blink {
            0%, 100% { opacity: 0.5; }
            50% { opacity: 1; }
        }
        
        /* Écrans de connexion/inscription */
        .auth-screen {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #0c0e29 0%, #1a1d4e 100%);
            padding: 40px 30px;
            display: none;
            flex-direction: column;
            z-index: 900;
        }
        
        .auth-header {
            text-align: center;
            margin-bottom: 40px;
        }
        
        .auth-logo {
            font-size: 2.2rem;
            font-weight: 800;
            background: linear-gradient(90deg, #ff3366, #ff9933);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            margin-bottom: 10px;
        }
        
        .auth-title {
            font-size: 1.8rem;
            font-weight: 600;
            margin-bottom: 10px;
        }
        
        .auth-subtitle {
            color: #a0a5d6;
            font-size: 1rem;
            margin-bottom: 30px;
        }
        
        .auth-form {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }
        
        .input-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        
        .input-label {
            font-size: 0.9rem;
            color: #a0a5d6;
            font-weight: 500;
        }
        
        .input-field {
            background-color: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 16px;
            color: white;
            font-size: 1rem;
            outline: none;
            transition: all 0.3s;
        }
        
        .input-field:focus {
            border-color: #5d00ff;
            background-color: rgba(93, 0, 255, 0.1);
        }
        
        .auth-button {
            background: linear-gradient(90deg, #5d00ff, #8a2be2);
            border: none;
            border-radius: 12px;
            padding: 18px;
            color: white;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            margin-top: 10px;
            transition: all 0.3s;
        }
        
        .auth-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(93, 0, 255, 0.3);
        }
        
        .auth-switch {
            text-align: center;
            margin-top: 25px;
            color: #a0a5d6;
        }
        
        .auth-link {
            color: #ff3366;
            font-weight: 600;
            cursor: pointer;
        }
        
        /* Pages (toutes cachées par défaut) */
        .page {
            display: none;
            flex-direction: column;
            height: 100%;
            background: #0c0e29;
            position: relative;
        }
        
        .page.active {
            display: flex;
            animation: fadeIn 0.3s ease;
        }
        
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        
        /* Header commun à toutes les pages */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 20px 15px;
            background: linear-gradient(135deg, #0c0e29 0%, #1a1d4e 100%);
            position: sticky;
            top: 0;
            z-index: 100;
        }
        
        .page-title {
            font-size: 1.6rem;
            font-weight: 600;
        }
        
        .back-button {
            font-size: 1.2rem;
            color: #a0a5d6;
            cursor: pointer;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            transition: all 0.3s;
        }
        
        .back-button:hover {
            background: rgba(255, 255, 255, 0.1);
        }
        
        .profile-icon {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: linear-gradient(135deg, #5d00ff 0%, #8a2be2 100%);
            display: flex;
            justify-content: center;
            align-items: center;
            font-weight: 600;
            cursor: pointer;
        }
        
        /* Page Accueil (Dashboard) - Euros uniquement */
        .home-balance-section {
            padding: 30px 20px;
            background: linear-gradient(135deg, #1a1d4e 0%, #2a2f7a 100%);
            border-radius: 20px;
            margin: 20px;
            margin-bottom: 20px;
        }
        
        .balance-label {
            font-size: 0.9rem;
            color: #a0a5d6;
            margin-bottom: 8px;
        }
        
        .balance-amount {
            font-size: 3.2rem;
            font-weight: 600;
            margin-bottom: 25px;
        }
        
        .balance-actions {
            display: flex;
            justify-content: space-between;
            gap: 15px;
        }
        
        .balance-action {
            flex: 1;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            padding: 18px 10px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        .balance-action:hover {
            background: rgba(255, 255, 255, 0.15);
            transform: translateY(-3px);
        }
        
        .action-icon {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 1.2rem;
        }
        
        .charger .action-icon {
            background: rgba(93, 0, 255, 0.2);
            color: #9d6dff;
        }
        
        .recevoir .action-icon {
            background: rgba(255, 51, 102, 0.2);
            color: #ff6699;
        }
        
        .swapp .action-icon {
            background: rgba(51, 204, 102, 0.2);
            color: #66ff99;
        }
        
        .action-name {
            font-size: 0.9rem;
            font-weight: 500;
        }
        
        /* Widget double solde sur l'accueil */
        .dual-balance-widget {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 20px;
            padding: 25px;
            margin: 0 20px 20px;
        }
        
        .dual-balance-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }
        
        .dual-balance-title {
            font-size: 1.4rem;
            font-weight: 500;
        }
        
        .dual-balance-refresh {
            color: #a0a5d6;
            cursor: pointer;
            font-size: 1.1rem;
            transition: all 0.3s;
        }
        
        .dual-balance-refresh:hover {
            color: white;
            transform: rotate(90deg);
        }
        
        .dual-balance-content {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }
        
        .balance-item-dual {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 12px;
        }
        
        .balance-currency {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        
        .currency-logo {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 1.1rem;
            font-weight: 600;
        }
        
        .eur-logo {
            background: rgba(0, 123, 255, 0.2);
            color: #4dabff;
        }
        
        .usdt-logo {
            background: rgba(38, 161, 123, 0.2);
            color: #26a17b;
        }
        
        .currency-name {
            font-weight: 600;
            font-size: 1.1rem;
        }
        
        .currency-fullname {
            font-size: 0.8rem;
            color: #a0a5d6;
        }
        
        .balance-value-dual {
            text-align: right;
        }
        
        .balance-amount-dual {
            font-size: 1.3rem;
            font-weight: 600;
            margin-bottom: 5px;
        }
        
        .balance-change {
            font-size: 0.9rem;
            color: #a0a5d6;
        }
        
        .positive {
            color: #66ff99;
        }
        
        .negative {
            color: #ff6699;
        }
        
        /* Page Portefeuille - USDT avec graphique */
        .wallet-header {
            padding: 25px 20px;
            background: linear-gradient(135deg, #1a1d4e 0%, #2a2f7a 100%);
            border-radius: 20px;
            margin: 20px;
            margin-bottom: 30px;
        }
        
        .wallet-balance-label {
            font-size: 0.8rem;
            color: #a0a5d6;
            margin-bottom: 20px;
        }
        
        .wallet-balance-amount {
            font-size: 2.5rem;
            font-weight: 400;
            color: #66ff99;
            margin-bottom: 20px;
        }
        
        .wallet-balance-eur {
            font-size: 1.1rem;
            color: #a0a5d6;
        }
        
        /* Widget Crypto dans portefeuille */
        .crypto-widget {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 20px;
            padding: 20px;
            margin: 0 20px 25px;
        }
        
        .crypto-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }
        
        .crypto-title {
            font-size: 1.2rem;
            font-weight: 600;
        }
        
        .crypto-subtitle {
            font-size: 0.9rem;
            color: #a0a5d6;
        }
        
        .chart-container {
            height: 180px;
            margin: 20px 0;
            position: relative;
        }
        
        .chart {
            width: 100%;
            height: 100%;
        }
        
        /* Historique des transactions sous le graphique */
        .transaction-history {
            margin: 25px 20px;
        }
        
        .transaction-history h3 {
            font-size: 1.2rem;
            font-weight: 600;
            margin-bottom: 20px;
        }
        
        .transaction-list {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 20px;
            padding: 20px;
            max-height: 400px;
            overflow-y: auto;
        }
        
        .transaction-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 15px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        .transaction-item:last-child {
            border-bottom: none;
        }
        
        .transaction-info {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        
        .transaction-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
        }
        
        .transaction-details h4 {
            font-weight: 600;
            margin-bottom: 5px;
        }
        
        .transaction-details p {
            font-size: 0.9rem;
            color: #a0a5d6;
        }
        
        .transaction-amount {
            font-weight: 600;
            text-align: right;
        }
        
        /* Contenu des pages */
        .page-content {
            flex: 1;
            overflow-y: auto;
            padding: 0 0 80px;
        }
        
        /* Page charger */
        .charger-options {
            display: flex;
            flex-direction: column;
            gap: 15px;
            margin-top: 20px;
        }
        
        .charger-option {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 16px;
            padding: 20px;
            display: flex;
            align-items: center;
            gap: 15px;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        .charger-option:hover {
            background: rgba(255, 255, 255, 0.08);
            transform: translateY(-3px);
        }
        
        .option-icon {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 1.3rem;
        }
        
        .stripe .option-icon {
            background: rgba(0, 123, 255, 0.2);
            color: #4dabff;
        }
        
        .option-info h3 {
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 5px;
        }
        
        .option-info p {
            font-size: 0.9rem;
            color: #a0a5d6;
        }
        
        .amount-options {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            margin-top: 30px;
        }
        
        .amount-option {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            padding: 20px 10px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        .amount-option:hover, .amount-option.selected {
            background: rgba(93, 0, 255, 0.2);
            border: 1px solid #5d00ff;
        }
        
        .amount {
            font-size: 1.3rem;
            font-weight: 600;
        }
        
        .amount-label {
            font-size: 0.8rem;
            color: #a0a5d6;
        }
        
        /* Bouton Valider plus grand */
        .validate-button {
            background: linear-gradient(90deg, #5d00ff, #8a2be2);
            border: none;
            border-radius: 12px;
            padding: 20px 25px;
            color: white;
            font-size: 1.2rem;
            font-weight: 600;
            cursor: pointer;
            margin: 20px auto;
            display: block;
            width: 100%;
            max-width: 300px;
            transition: all 0.3s;
        }
        
        .validate-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(93, 0, 255, 0.3);
        }
        
        /* Page Recevoir */
        .receive-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            margin-top: 30px;
        }
        
        .qr-code {
            width: 220px;
            height: 220px;
            background: white;
            border-radius: 16px;
            margin-bottom: 30px;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            overflow: hidden;
        }
        
        .qr-code::before {
            content: '';
            position: absolute;
            width: 100%;
            height: 100%;
            background: linear-gradient(45deg, transparent 48%, #000 50%, transparent 52%);
            background-size: 10px 10px;
        }
        
        .qr-code::after {
            content: 'REVOLTé';
            position: absolute;
            bottom: 10px;
            font-weight: 600;
            color: #000;
            font-size: 0.9rem;
        }
        
        .wallet-address {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            padding: 15px;
            width: 100%;
            margin-bottom: 30px;
            position: relative;
        }
        
        .address-title {
            font-size: 0.9rem;
            color: #a0a5d6;
            margin-bottom: 10px;
        }
        
        .address-value {
            font-family: monospace;
            font-size: 0.9rem;
            word-break: break-all;
            margin-bottom: 15px;
        }
        
        .copy-button {
            background: rgba(93, 0, 255, 0.2);
            color: #9d6dff;
            border: none;
            border-radius: 8px;
            padding: 10px 20px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            margin: 0 auto;
        }
        
        .crypto-selector {
            width: 100%;
            margin-top: 20px;
        }
        
        .crypto-option {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 15px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            margin-bottom: 10px;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        .crypto-option:hover, .crypto-option.selected {
            background: rgba(93, 0, 255, 0.2);
        }
        
        .crypto-logo {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 1.2rem;
            font-weight: 600;
        }
        
        .usdt-logo {
            background: #26a17b;
            color: white;
        }
        
        /* Page Swapp */
        .swap-container {
            margin-top: 20px;
        }
        
        .swap-card {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 20px;
            padding: 25px;
            margin-bottom: 20px;
        }
        
        .swap-input {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        
        .swap-amount {
            flex: 1;
        }
        
        .swap-amount input {
            width: 100%;
            background: transparent;
            border: none;
            color: white;
            font-size: 2.5rem;
            font-weight: 600;
            outline: none;
        }
        
        .swap-currency {
            display: flex;
            align-items: center;
            gap: 8px;
            background: rgba(255, 255, 255, 0.1);
            padding: 10px 15px;
            border-radius: 12px;
            cursor: pointer;
        }
        
        .swap-center {
            display: flex;
            justify-content: center;
            margin: 20px 0;
        }
        
        .swap-button {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: linear-gradient(90deg, #5d00ff, #8a2be2);
            border: none;
            color: white;
            font-size: 1.2rem;
            cursor: pointer;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        
        .swap-info {
            display: flex;
            justify-content: space-between;
            margin-top: 15px;
            color: #a0a5d6;
            font-size: 0.9rem;
        }
        
        .swap-button-large {
            width: 100%;
            padding: 20px;
            background: linear-gradient(90deg, #5d00ff, #8a2be2);
            border: none;
            border-radius: 16px;
            color: white;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            margin-top: 20px;
        }
        
        /* Page Paramètres */
        .settings-list {
            margin-top: 20px;
        }
        
        .setting-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 20px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            cursor: pointer;
        }
        
        .setting-info {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        
        .setting-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: rgba(93, 0, 255, 0.2);
            color: #9d6dff;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 1.1rem;
        }
        
        .setting-details h3 {
            font-size: 1rem;
            font-weight: 600;
            margin-bottom: 5px;
        }
        
        .setting-details p {
            font-size: 0.8rem;
            color: #a0a5d6;
        }
        
        .logout-button {
            width: 100%;
            padding: 20px;
            background: rgba(255, 51, 102, 0.2);
            border: 1px solid rgba(255, 51, 102, 0.5);
            border-radius: 16px;
            color: #ff6699;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            margin-top: 40px;
            display: flex;
            justify-content: center;
            gap: 10px;
        }
        
        /* Menu du bas */
        .bottom-menu {
            position: fixed;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 100%;
            max-width: 500px;
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            justify-content: space-around;
            padding: 15px 0;
            border-radius: 25px 25px 0 0;
            z-index: 200;
        }
        
        .menu-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 5px;
            cursor: pointer;
            transition: all 0.3s;
            color: #a0a5d6;
            flex: 1;
        }
        
        .menu-item.active {
            color: #ff3366;
        }
        
        .menu-item:hover {
            color: white;
        }
        
        .menu-icon {
            font-size: 1.3rem;
        }
        
        .menu-label {
            font-size: 0.8rem;
            font-weight: 500;
        }
        
        /* Modal */
        .modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.8);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 1001;
            display: none;
        }
        
        .modal-content {
            background: linear-gradient(135deg, #1a1d4e 0%, #2a2f7a 100%);
            border-radius: 25px;
            width: 90%;
            max-width: 450px;
            padding: 30px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
        }
        
        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }
        
        .modal-title {
            font-size: 1.5rem;
            font-weight: 600;
        }
        
        .close-modal {
            font-size: 1.5rem;
            cursor: pointer;
            color: #a0a5d6;
        }
        
        .free-badge {
            background: linear-gradient(90deg, #ff3366, #ff9933);
            color: white;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 600;
            margin-left: 10px;
        }
        
        .hidden {
            display: none !important;
        }
        
        .notification {
            position: fixed;
            top: 20px;
            right: 20px;
            background: linear-gradient(90deg, #5d00ff, #8a2be2);
            color: white;
            padding: 15px 25px;
            border-radius: 12px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
            z-index: 1002;
            display: none;
            animation: slideIn 0.3s ease;
        }
        
        @keyframes slideIn {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Écran de chargement avec bulle -->
        <div class="loading-screen" id="loadingScreen">
            <div class="app-bubble">
                <div class="app-name">RÉVOLTE!</div>
            </div>
            <div class="tagline">Expérience bancaire intuitive</div>
            <div class="loading-text">Chargement...</div>
        </div>
        
        <!-- Écran de connexion -->
        <div class="auth-screen fade-in" id="loginScreen" style="display: none;">
            <div class="auth-header">
                <div class="auth-logo">RÉVOLTE!</div>
                <div class="auth-title">Bon retour !</div>
                <div class="auth-subtitle">Connectez-vous pour accéder à votre compte</div>
            </div>
            <div class="auth-form">
                <div class="input-group">
                    <label class="input-label">E-mail</label>
                    <input type="email" class="input-field" id="loginEmail" placeholder="votre@email.com">
                </div>
                <div class="input-group">
                    <label class="input-label">Mot de passe</label>
                    <input type="password" class="input-field" id="loginPassword" placeholder="Votre mot de passe">
                </div>
                <button class="auth-button" id="loginButton">Se connecter</button>
            </div>
            <div class="auth-switch">
                Vous n'avez pas de compte ? <span class="auth-link" id="showRegister">S'inscrire</span>
            </div>
        </div>
        
        <!-- Écran d'inscription -->
        <div class="auth-screen" id="registerScreen">
            <div class="auth-header">
                <div class="auth-logo">RÉVOLTE!</div>
                <div class="auth-title">Rejoignez REVOLTé</div>
                <div class="auth-subtitle">Découvrez une nouvelle plateforme de finance</div>
            </div>
            <div class="auth-form">
                <div class="input-group">
                    <label class="input-label">Nom complet</label>
                    <input type="text" class="input-field" id="registerName" placeholder="Votre nom">
                </div>
                <div class="input-group">
                    <label class="input-label">E-mail</label>
                    <input type="email" class="input-field" id="registerEmail" placeholder="votre@email.com">
                </div>
                <div class="input-group">
                    <label class="input-label">Mot de passe</label>
                    <input type="password" class="input-field" id="registerPassword" placeholder="Créez un mot de passe">
                </div>
                <button class="auth-button" id="registerButton">Créer un compte</button>
            </div>
            <div class="auth-switch">
                Vous avez déjà un compte ? <span class="auth-link" id="showLogin">Se connecter</span>
            </div>
        </div>
        
        <!-- Page Accueil (Dashboard) - Euros -->
        <div class="page" id="homePage">
            <div class="header">
                <div class="greeting">
                    <h1 id="userGreeting">Bonjour,</h1>
                    <p>Votre compte en euros</p>
                </div>
                <div class="profile-icon" id="profileIcon"></div>
            </div>
            
            <div class="page-content">
                <!-- Solde en euros -->
                <div class="home-balance-section">
                    <div class="balance-label">Solde EUR</div>
                    <div class="balance-amount" id="eurBalance">0,00 €</div>
                    <div class="balance-actions">
                        <div class="balance-action charger" data-page="charger">
                            <div class="action-icon">
                                <i class="fas fa-plus"></i>
                            </div>
