    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // ============================================
        // BASE DE DONNÉES SIMULÉE
        // ============================================
        
        class Database {
            constructor() {
                this.users = JSON.parse(localStorage.getItem('revolte_users')) || [];
                this.transactions = JSON.parse(localStorage.getItem('revolte_transactions')) || {};
                this.currentUser = null;
                this.exchangeRate = 1.05; // 1 EUR = 1.05 USDT
                this.feePercentage = 0.5; // 0.5% de frais
            }
            
            saveUsers() {
                localStorage.setItem('revolte_users', JSON.stringify(this.users));
            }
            
            saveTransactions() {
                localStorage.setItem('revolte_transactions', JSON.stringify(this.transactions));
            }
            
            generateUserId() {
                return 'user_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
            }
            
            generateTransactionId() {
                return 'tx_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
            }
            
            generateWalletAddress() {
                const chars = '0123456789abcdef';
                let address = '0x';
                for (let i = 0; i < 40; i++) {
                    address += chars[Math.floor(Math.random() * chars.length)];
                }
                return address;
            }
            
            registerUser(name, email, password) {
                // Vérifier si l'email existe déjà
                if (this.users.find(user => user.email === email)) {
                    return { success: false, message: 'Cet email est déjà utilisé' };
                }
                
                const userId = this.generateUserId();
                const walletAddress = this.generateWalletAddress();
                
                const newUser = {
                    id: userId,
                    name: name,
                    email: email,
                    password: password, // En production, il faudrait hacher le mot de passe
                    createdAt: new Date().toISOString(),
                    balances: {
                        eur: 0.00,
                        usdt: 0.00
                    },
                    walletAddress: walletAddress,
                    transactions: []
                };
                
                this.users.push(newUser);
                this.saveUsers();
                
                // Initialiser les transactions pour cet utilisateur
                this.transactions[userId] = [];
                this.saveTransactions();
                
                return { success: true, user: newUser };
            }
            
            loginUser(email, password) {
                const user = this.users.find(u => u.email === email && u.password === password);
                
                if (user) {
                    this.currentUser = user;
                    return { success: true, user: user };
                } else {
                    return { success: false, message: 'Email ou mot de passe incorrect' };
                }
            }
            
            logout() {
                this.currentUser = null;
            }
            
            getCurrentUser() {
                return this.currentUser;
            }
            
            updateUserBalance(userId, currency, amount) {
                const user = this.users.find(u => u.id === userId);
                if (user) {
                    if (currency === 'eur') {
                        user.balances.eur = parseFloat((user.balances.eur + amount).toFixed(2));
                    } else if (currency === 'usdt') {
                        user.balances.usdt = parseFloat((user.balances.usdt + amount).toFixed(2));
                    }
                    this.saveUsers();
                    return true;
                }
                return false;
            }
            
            addTransaction(userId, type, amount, currency, description, fee = 0) {
                const transaction = {
                    id: this.generateTransactionId(),
                    type: type, // 'deposit', 'withdrawal', 'exchange', 'transfer'
                    amount: amount,
                    currency: currency,
                    description: description,
                    fee: fee,
                    timestamp: new Date().toISOString(),
                    status: 'completed'
                };
                
                if (!this.transactions[userId]) {
                    this.transactions[userId] = [];
                }
                
                this.transactions[userId].unshift(transaction);
                this.saveTransactions();
                
                // Limiter à 50 transactions maximum
                if (this.transactions[userId].length > 50) {
                    this.transactions[userId] = this.transactions[userId].slice(0, 50);
                }
                
                return transaction;
            }
            
            getUserTransactions(userId, limit = 10) {
                return this.transactions[userId] || [];
            }
            
            calculateExchange(fromAmount, fromCurrency, toCurrency) {
                let toAmount = 0;
                
                if (fromCurrency === 'eur' && toCurrency === 'usdt') {
                    toAmount = fromAmount * this.exchangeRate;
                } else if (fromCurrency === 'usdt' && toCurrency === 'eur') {
                    toAmount = fromAmount / this.exchangeRate;
                }
                
                // Appliquer les frais
                const fee = toAmount * (this.feePercentage / 100);
                const netAmount = toAmount - fee;
                
                return {
                    grossAmount: parseFloat(toAmount.toFixed(2)),
                    fee: parseFloat(fee.toFixed(2)),
                    netAmount: parseFloat(netAmount.toFixed(2)),
                    rate: this.exchangeRate
                };
            }
            
            performExchange(userId, fromAmount, fromCurrency, toCurrency) {
                const user = this.users.find(u => u.id === userId);
                if (!user) return { success: false, message: 'Utilisateur non trouvé' };
                
                // Vérifier le solde
                if (fromCurrency === 'eur' && user.balances.eur < fromAmount) {
                    return { success: false, message: 'Solde EUR insuffisant' };
                }
                if (fromCurrency === 'usdt' && user.balances.usdt < fromAmount) {
                    return { success: false, message: 'Solde USDT insuffisant' };
                }
                
                // Calculer l'échange
                const exchange = this.calculateExchange(fromAmount, fromCurrency, toCurrency);
                
                // Mettre à jour les soldes
                if (fromCurrency === 'eur') {
                    user.balances.eur = parseFloat((user.balances.eur - fromAmount).toFixed(2));
                    user.balances.usdt = parseFloat((user.balances.usdt + exchange.netAmount).toFixed(2));
                } else {
                    user.balances.usdt = parseFloat((user.balances.usdt - fromAmount).toFixed(2));
                    user.balances.eur = parseFloat((user.balances.eur + exchange.netAmount).toFixed(2));
                }
                
                this.saveUsers();
                
                // Ajouter la transaction
                const description = `Échange ${fromAmount} ${fromCurrency.toUpperCase()} → ${exchange.netAmount} ${toCurrency.toUpperCase()}`;
                this.addTransaction(userId, 'exchange', fromAmount, fromCurrency, description, exchange.fee);
                
                return {
                    success: true,
                    fromAmount: fromAmount,
                    toAmount: exchange.netAmount,
                    fee: exchange.fee,
                    newEurBalance: user.balances.eur,
                    newUsdtBalance: user.balances.usdt
                };
            }
            
            simulatePriceChange() {
                // Simuler une petite variation de prix aléatoire
                const change = (Math.random() - 0.5) * 0.02; // ±1%
                this.exchangeRate = parseFloat((this.exchangeRate * (1 + change)).toFixed(4));
                return this.exchangeRate;
            }
        }
        
        // ============================================
        // INITIALISATION DE L'APPLICATION
        // ============================================
        
        const db = new Database();
        let cryptoChart = null;
        
        document.addEventListener('DOMContentLoaded', function() {
            const loadingScreen = document.getElementById('loadingScreen');
            const loginScreen = document.getElementById('loginScreen');
            const registerScreen = document.getElementById('registerScreen');
            const pages = document.querySelectorAll('.page');
            const menuItems = document.querySelectorAll('.menu-item');
            const balanceActions = document.querySelectorAll('.balance-action');
            
            // Simuler un chargement de 2 secondes
            setTimeout(() => {
                loadingScreen.style.opacity = '0';
                setTimeout(() => {
                    loadingScreen.classList.add('hidden');
                    loginScreen.style.display = 'flex';
                    loginScreen.classList.add('fade-in');
                }, 800);
            }, 2000);
            
            // ============================================
            // GESTION DE L'AUTHENTIFICATION
            // ============================================
            
            document.getElementById('showRegister').addEventListener('click', function() {
                loginScreen.style.display = 'none';
                registerScreen.style.display = 'flex';
                registerScreen.classList.add('fade-in');
            });
            
            document.getElementById('showLogin').addEventListener('click', function() {
                registerScreen.style.display = 'none';
                loginScreen.style.display = 'flex';
                loginScreen.classList.add('fade-in');
            });
            
            // Connexion
            document.getElementById('loginButton').addEventListener('click', function() {
                const email = document.getElementById('loginEmail').value.trim();
                const password = document.getElementById('loginPassword').value;
                
                if (!email || !password) {
                    showNotification('Veuillez remplir tous les champs', 'error');
                    return;
                }
                
                const result = db.loginUser(email, password);
                
                if (result.success) {
                    loginScreen.style.display = 'none';
                    showNotification('Connexion réussie !', 'success');
                    initializeUserDashboard(result.user);
                    showPage('home');
                    initChart();
                } else {
                    showNotification(result.message, 'error');
                }
            });
            
            // Inscription
            document.getElementById('registerButton').addEventListener('click', function() {
                const name = document.getElementById('registerName').value.trim();
                const email = document.getElementById('registerEmail').value.trim();
                const password = document.getElementById('registerPassword').value;
                
                if (!name || !email || !password) {
                    showNotification('Veuillez remplir tous les champs', 'error');
                    return;
                }
                
                if (password.length < 6) {
                    showNotification('Le mot de passe doit contenir au moins 6 caractères', 'error');
                    return;
                }
                
                const result = db.registerUser(name, email, password);
                
                if (result.success) {
                    registerScreen.style.display = 'none';
                    showNotification('Compte créé avec succès !', 'success');
                    
                    // Connecter automatiquement l'utilisateur
                    db.loginUser(email, password);
                    initializeUserDashboard(result.user);
                    showPage('home');
                    initChart();
                    
                    // Mettre à jour l'adresse wallet
                    document.getElementById('walletAddress').textContent = result.user.walletAddress;
                } else {
                    showNotification(result.message, 'error');
                }
            });
            
            // ============================================
            // FONCTIONS UTILITAIRES
            // ============================================
            
            function showNotification(message, type = 'info') {
                const notification = document.getElementById('notification');
                notification.textContent = message;
                notification.style.display = 'block';
                
                // Couleur selon le type
                if (type === 'success') {
                    notification.style.background = 'linear-gradient(90deg, #26a17b, #66ff99)';
                } else if (type === 'error') {
                    notification.style.background = 'linear-gradient(90deg, #ff3366, #ff6699)';
                } else {
                    notification.style.background = 'linear-gradient(90deg, #5d00ff, #8a2be2)';
                }
                
                setTimeout(() => {
                    notification.style.display = 'none';
                }, 3000);
            }
            
            function formatCurrency(amount, currency = 'eur') {
                if (currency === 'eur') {
                    return new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR' }).format(amount);
                } else {
                    return new Intl.NumberFormat('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(amount) + ' ' + currency.toUpperCase();
                }
            }
            
            function formatDate(dateString) {
                const date = new Date(dateString);
                const now = new Date();
                const diffMs = now - date;
                const diffMins = Math.floor(diffMs / 60000);
                const diffHours = Math.floor(diffMs / 3600000);
                const diffDays = Math.floor(diffMs / 86400000);
                
                if (diffMins < 1) {
                    return 'À l\'instant';
                } else if (diffMins < 60) {
                    return `Il y a ${diffMins} min`;
                } else if (diffHours < 24) {
                    return `Il y a ${diffHours} h`;
                } else if (diffDays === 1) {
                    return 'Hier';
                } else if (diffDays < 7) {
                    return `Il y a ${diffDays} jours`;
                } else {
                    return date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' });
                }
            }
            
            function initializeUserDashboard(user) {
                // Mettre à jour le nom
                document.getElementById('userGreeting').textContent = `Bonjour, ${user.name.split(' ')[0]}`;
                
                // Mettre à jour l'icône de profil
                const initials = user.name.split(' ').map(n => n[0]).join('').toUpperCase().substring(0, 2);
                document.getElementById('profileIcon').textContent = initials;
                document.getElementById('walletProfileIcon').textContent = initials;
                document.getElementById('chargerProfileIcon').textContent = initials;
                document.getElementById('receiveProfileIcon').textContent = initials;
                document.getElementById('swapProfileIcon').textContent = initials;
                document.getElementById('settingsProfileIcon').textContent = initials;
                
                // Mettre à jour les soldes
                updateBalances();
                
                // Mettre à jour l'adresse wallet
                document.getElementById('walletAddress').textContent = user.walletAddress;
                
                // Mettre à jour les transactions
                updateTransactions();
                
                // Mettre à jour le profil dans les paramètres
                document.getElementById('profileSetting').addEventListener('click', function() {
                    alert(`Nom: ${user.name}\nEmail: ${user.email}\nAdresse USDT: ${user.walletAddress}\nDate d'inscription: ${new Date(user.createdAt).toLocaleDateString('fr-FR')}`);
                });
            }
            
            function updateBalances() {
                const user = db.getCurrentUser();
                if (!user) return;
                
                // Mettre à jour les soldes EUR
                document.getElementById('eurBalance').textContent = formatCurrency(user.balances.eur, 'eur');
                document.getElementById('dualEurBalance').textContent = formatCurrency(user.balances.eur, 'eur');
                document.getElementById('chargerCurrentBalance').textContent = formatCurrency(user.balances.eur, 'eur');
                document.getElementById('fromBalance').textContent = formatCurrency(user.balances.eur, 'eur');
                
                // Mettre à jour les soldes USDT
                document.getElementById('dualUsdtBalance').textContent = formatCurrency(user.balances.usdt, 'usdt');
                document.getElementById('walletUsdtBalance').textContent = formatCurrency(user.balances.usdt, 'usdt');
                document.getElementById('toBalance').textContent = formatCurrency(user.balances.usdt, 'usdt');
                
                // Calculer la valeur en EUR des USDT
                const usdtValueEur = user.balances.usdt / db.exchangeRate;
                document.getElementById('walletUsdtEurValue').textContent = `≈ ${formatCurrency(usdtValueEur, 'eur')}`;
                
                // Mettre à jour le prix USDT
                document.getElementById('usdtPrice').textContent = `$${db.exchangeRate.toFixed(2)}`;
                document.getElementById('exchangeRateDisplay').textContent = `1 EUR = ${db.exchangeRate.toFixed(2)} USDT`;
                document.getElementById('fromRate').textContent = db.exchangeRate.toFixed(2);
                document.getElementById('toRate').textContent = (1 / db.exchangeRate).toFixed(2);
                
                // Simuler un changement de prix occasionnel
                if (Math.random() < 0.3) {
                    const newRate = db.simulatePriceChange();
                    const change = ((newRate - 1.05) / 1.05) * 100;
                    document.getElementById('usdtChange').textContent = `${change >= 0 ? '+' : ''}${change.toFixed(2)}%`;
                    document.getElementById('usdtChange').style.color = change >= 0 ? '#66ff99' : '#ff6699';
                    document.getElementById('dualUsdtBalance').nextElementSibling.textContent = `${change >= 0 ? '+' : ''}${change.toFixed(2)}%`;
                    document.getElementById('dualUsdtBalance').nextElementSibling.className = change >= 0 ? 'balance-change positive' : 'balance-change negative';
                }
            }
            
            function updateTransactions() {
                const user = db.getCurrentUser();
                if (!user) return;
                
                const transactions = db.getUserTransactions(user.id);
                
                // Mettre à jour les transactions récentes
                const recentTransactionsContainer = document.getElementById('recentTransactions');
                const usdtTransactionsContainer = document.getElementById('usdtTransactions');
                
                if (transactions.length === 0) {
                    recentTransactionsContainer.innerHTML = `
                        <div style="text-align: center; padding: 30px; color: #a0a5d6;">
                            <i class="fas fa-exchange-alt" style="font-size: 2rem; margin-bottom: 15px;"></i>
                            <p>Aucune transaction pour le moment</p>
                        </div>
                    `;
                    usdtTransactionsContainer.innerHTML = `
                        <div style="text-align: center; padding: 30px; color: #a0a5d6;">
                            <i class="fas fa-wallet" style="font-size: 2rem; margin-bottom: 15px;"></i>
                            <p>Aucune transaction USDT pour le moment</p>
                        </div>
                    `;
                    return;
                }
                
                // Filtrer les transactions USDT
                const usdtTransactions = transactions.filter(t => t.currency === 'usdt' || (t.type === 'exchange' && (t.description.includes('USDT') || t.description.includes('usdt'))));
                
                // Afficher les 5 dernières transactions générales
                recentTransactionsContainer.innerHTML = transactions.slice(0, 5).map(transaction => {
                    const isPositive = transaction.type === 'deposit' || (transaction.type === 'exchange' && transaction.description.includes('→ USDT'));
                    const icon = transaction.type === 'deposit' ? 'fa-arrow-down' : 
                                transaction.type === 'exchange' ? 'fa-exchange-alt' : 'fa-arrow-up';
                    const iconColor = transaction.type === 'deposit' ? '#9d6dff' : 
                                    transaction.type === 'exchange' ? '#ff6699' : '#66ff99';
                    
                    return `
                        <div class="transaction-item">
                            <div class="transaction-info">
                                <div class="transaction-icon" style="background: rgba(${iconColor === '#9d6dff' ? '93,0,255' : iconColor === '#ff6699' ? '255,51,102' : '51,204,102'},0.2); color: ${iconColor};">
                                    <i class="fas ${icon}"></i>
                                </div>
                                <div class="transaction-details">
                                    <h4>${transaction.description}</h4>
                                    <p>${formatDate(transaction.timestamp)}</p>
                                </div>
                            </div>
                            <div class="transaction-amount" style="color: ${isPositive ? '#66ff99' : '#ff6699'}">
                                ${isPositive ? '+' : '-'}${formatCurrency(transaction.amount, transaction.currency)}
                            </div>
                        </div>
                    `;
                }).join('');
                
                // Afficher les 5 dernières transactions USDT
                usdtTransactionsContainer.innerHTML = usdtTransactions.slice(0, 5).map(transaction => {
                    const isPositive = transaction.type === 'deposit' || (transaction.type === 'exchange' && transaction.description.includes('→ USDT'));
                    const icon = transaction.type === 'deposit' ? 'fa-arrow-down' : 
                                transaction.type === 'exchange' ? 'fa-exchange-alt' : 'fa-arrow-up';
                    const iconColor = transaction.type === 'deposit' ? '#9d6dff' : 
                                    transaction.type === 'exchange' ? '#ff6699' : '#66ff99';
                    
                    return `
                        <div class="transaction-item">
                            <div class="transaction-info">
                                <div class="transaction-icon" style="background: rgba(${iconColor === '#9d6dff' ? '93,0,255' : iconColor === '#ff6699' ? '255,51,102' : '51,204,102'},0.2); color: ${iconColor};">
                                    <i class="fas ${icon}"></i>
                                </div>
                                <div class="transaction-details">
                                    <h4>${transaction.description}</h4>
                                    <p>${formatDate(transaction.timestamp)}</p>
                                </div>
                            </div>
                            <div class="transaction-amount" style="color: ${isPositive ? '#66ff99' : '#ff6699'}">
                                ${isPositive ? '+' : '-'}${formatCurrency(transaction.amount, transaction.currency)}
                            </div>
                        </div>
                    `;
                }).join('');
                
                if (usdtTransactions.length === 0) {
                    usdtTransactionsContainer.innerHTML = `
                        <div style="text-align: center; padding: 30px; color: #a0a5d6;">
                            <i class="fas fa-wallet" style="font-size: 2rem; margin-bottom: 15px;"></i>
                            <p>Aucune transaction USDT pour le moment</p>
                        </div>
                    `;
                }
            }
            
            // ============================================
            // NAVIGATION
            // ============================================
            
            function showPage(pageId) {
                // Masquer toutes les pages
                pages.forEach(page => {
                    page.classList.remove('active');
                });
                
                // Afficher la page demandée
                const pageElement = document.getElementById(`${pageId}Page`);
                if (pageElement) {
                    pageElement.classList.add('active');
                    
                    // Mettre à jour les données si nécessaire
                    if (pageId === 'home' || pageId === 'portefeuille' || pageId === 'charger' || pageId === 'swapp') {
                        updateBalances();
                        if (pageId === 'home' || pageId === 'portefeuille') {
                            updateTransactions();
                        }
                    }
                }
                
                // Mettre à jour le menu actif
                menuItems.forEach(item => {
                    if (item.dataset.page === pageId) {
                        item.classList.add('active');
                    } else {
                        item.classList.remove('active');
                    }
                });
            }
            
            // Navigation par le menu du bas
            menuItems.forEach(item => {
                item.addEventListener('click', function() {
                    const pageId = this.dataset.page;
                    showPage(pageId);
                });
            });
            
            // Navigation par les boutons d'action sur l'accueil
            balanceActions.forEach(action => {
                action.addEventListener('click', function() {
                    const pageId = this.dataset.page;
                    showPage(pageId);
                });
            });
            
            // Navigation par les boutons de retour
            document.querySelectorAll('.back-button').forEach(button => {
                button.addEventListener('click', function() {
                    const pageId = this.dataset.page;
                    showPage(pageId);
                });
            });
            
            // ============================================
            // FONCTIONNALITÉS DE L'APPLICATION
            // ============================================
            
            // Rafraîchissement des soldes
            document.getElementById('refreshBalances').addEventListener('click', function() {
                this.style.transform = 'rotate(360deg)';
                setTimeout(() => {
                    this.style.transform = 'rotate(0deg)';
                }, 500);
                
                // Simuler un changement de prix
                const newRate = db.simulatePriceChange();
                updateBalances();
                showNotification('Soldes et taux actualisés', 'success');
            });
            
            // Gestion de la page Charger
            document.querySelectorAll('.amount-option').forEach(option => {
                option.addEventListener('click', function() {
                    // Retirer la sélection précédente
                    document.querySelectorAll('.amount-option').forEach(opt => {
                        opt.classList.remove('selected');
                    });
                    
                    // Sélectionner l'option cliquée
                    this.classList.add('selected');
                    const amount = this.dataset.amount;
                    
                    // Remplir le champ personnalisé
                    document.getElementById('customAmount').value = amount;
                });
            });
            
            // Chargement personnalisé
            document.getElementById('customCharger').addEventListener('click', function() {
                const amountInput = document.getElementById('customAmount');
                const amount = parseFloat(amountInput.value);
                
                if (!amount || amount <= 0) {
                    showNotification('Veuillez entrer un montant valide', 'error');
                    return;
                }
                
                if (amount > 10000) {
                    showNotification('Le montant maximum est de 10 000€ par transaction', 'error');
                    return;
                }
                
                const user = db.getCurrentUser();
                if (!user) {
                    showNotification('Utilisateur non connecté', 'error');
                    return;
                }
                
                // Simuler un chargement Stripe
                showNotification(`Chargement de ${formatCurrency(amount, 'eur')} initié...`, 'info');
                
                // Simuler le traitement
                setTimeout(() => {
                    // Mettre à jour le solde
                    db.updateUserBalance(user.id, 'eur', amount);
                    
                    // Ajouter la transaction
                    db.addTransaction(user.id, 'deposit', amount, 'eur', 'Chargement par carte Stripe');
                    
                    // Mettre à jour l'affichage
                    updateBalances();
                    updateTransactions();
                    
                    showNotification(`Paiement réussi ! Votre compte a été crédité de ${formatCurrency(amount, 'eur')}.`, 'success');
                    
                    // Revenir à l'accueil
                    showPage('home');
                }, 2000);
            });
            
            // Chargement via option Stripe
            document.getElementById('stripeOption').addEventListener('click', function() {
                const selectedAmount = document.querySelector('.amount-option.selected');
                let amount = 100; // Valeur par défaut
                
                if (selectedAmount) {
                    amount = parseFloat(selectedAmount.dataset.amount);
                }
                
                const user = db.getCurrentUser();
                if (!user) {
                    showNotification('Utilisateur non connecté', 'error');
                    return;
                }
                
                // Simuler un chargement Stripe
                showNotification(`Chargement de ${formatCurrency(amount, 'eur')} initié...`, 'info');
                
                // Simuler le traitement
                setTimeout(() => {
                    // Mettre à jour le solde
                    db.updateUserBalance(user.id, 'eur', amount);
                    
                    // Ajouter la transaction
                    db.addTransaction(user.id, 'deposit', amount, 'eur', 'Chargement par carte Stripe');
                    
                    // Mettre à jour l'affichage
                    updateBalances();
                    updateTransactions();
                    
                    showNotification(`Paiement réussi ! Votre compte a été crédité de ${formatCurrency(amount, 'eur')}.`, 'success');
                    
                    // Revenir à l'accueil
                    showPage('home');
                }, 2000);
            });
            
            // Gestion de la page Recevoir
            document.getElementById('copyAddress').addEventListener('click', function() {
                const address = document.getElementById('walletAddress').textContent;
                navigator.clipboard.writeText(address).then(() => {
                    const originalHTML = this.innerHTML;
                    this.innerHTML = '<i class="fas fa-check"></i> Adresse copiée';
                    showNotification('Adresse copiée dans le presse-papier', 'success');
                    setTimeout(() => {
                        this.innerHTML = originalHTML;
                    }, 2000);
                });
            });
            
            // ============================================
            // GESTION DES ÉCHANGES (SWAP)
            // ============================================
            
            const fromAmount = document.getElementById('fromAmount');
            const toAmount = document.getElementById('toAmount');
            const swapDirection = document.getElementById('swapDirection');
            const fromCurrency = document.getElementById('fromCurrency');
            const toCurrency = document.getElementById('toCurrency');
            const feeAmount = document.getElementById('feeAmount');
            const netAmount = document.getElementById('netAmount');
            
            let isEurToUsdt = true; // Par défaut: EUR → USDT
            
            function updateExchangeCalculation() {
                const fromValue = parseFloat(fromAmount.value) || 0;
                
                if (fromValue <= 0) {
                    toAmount.value = '0';
                    feeAmount.textContent = '€0,00';
                    netAmount.textContent = '0,00 USDT';
                    return;
                }
                
                const exchange = db.calculateExchange(
                    fromValue,
                    isEurToUsdt ? 'eur' : 'usdt',
                    isEurToUsdt ? 'usdt' : 'eur'
                );
                
                toAmount.value = exchange.netAmount.toFixed(2);
                feeAmount.textContent = isEurToUsdt ? 
                    `${formatCurrency(exchange.fee / db.exchangeRate, 'eur')}` : 
                    `${formatCurrency(exchange.fee * db.exchangeRate, 'usdt')}`;
                netAmount.textContent = isEurToUsdt ? 
                    `${exchange.netAmount.toFixed(2)} USDT` : 
                    `${formatCurrency(exchange.netAmount, 'eur')}`;
            }
            
            fromAmount.addEventListener('input', updateExchangeCalculation);
            
            swapDirection.addEventListener('click', function() {
                // Inverser les devises
                isEurToUsdt = !isEurToUsdt;
                
                const fromText = fromCurrency.querySelector('div').textContent;
                const toText = toCurrency.querySelector('div').textContent;
                
                fromCurrency.querySelector('div').textContent = toText;
                toCurrency.querySelector('div').textContent = fromText;
                
                // Mettre à jour les labels de solde
                const user = db.getCurrentUser();
                if (user) {
                    if (isEurToUsdt) {
                        document.getElementById('fromBalance').textContent = formatCurrency(user.balances.eur, 'eur');
                        document.getElementById('toBalance').textContent = formatCurrency(user.balances.usdt, 'usdt');
                    } else {
                        document.getElementById('fromBalance').textContent = formatCurrency(user.balances.usdt, 'usdt');
                        document.getElementById('toBalance').textContent = formatCurrency(user.balances.eur, 'eur');
                    }
                }
                
                // Mettre à jour le taux affiché
                document.getElementById('exchangeRateDisplay').textContent = isEurToUsdt ? 
                    `1 EUR = ${db.exchangeRate.toFixed(2)} USDT` : 
                    `1 USDT = ${(1 / db.exchangeRate).toFixed(2)} EUR`;
                
                // Réinitialiser les montants
                fromAmount.value = '0';
                toAmount.value = '0';
                feeAmount.textContent = isEurToUsdt ? '€0,00' : '0,00 USDT';
                netAmount.textContent = isEurToUsdt ? '0,00 USDT' : '€0,00';
            });
            
            // Confirmation d'échange
            document.getElementById('confirmSwap').addEventListener('click', function() {
                const fromValue = parseFloat(fromAmount.value) || 0;
                
                if (fromValue <= 0) {
                    showNotification('Veuillez entrer un montant valide', 'error');
                    return;
                }
                
                const user = db.getCurrentUser();
                if (!user) {
                    showNotification('Utilisateur non connecté', 'error');
                    return;
                }
                
                // Vérifier le solde
                if (isEurToUsdt && user.balances.eur < fromValue) {
                    showNotification('Solde EUR insuffisant', 'error');
                    return;
                }
                if (!isEurToUsdt && user.balances.usdt < fromValue) {
                    showNotification('Solde USDT insuffisant', 'error');
                    return;
                }
                
                // Effectuer l'échange
                const result = db.performExchange(
                    user.id,
                    fromValue,
                    isEurToUsdt ? 'eur' : 'usdt',
                    isEurToUsdt ? 'usdt' : 'eur'
                );
                
                if (result.success) {
                    showNotification(`Échange réussi ! ${formatCurrency(fromValue, isEurToUsdt ? 'eur' : 'usdt')} → ${formatCurrency(result.toAmount, isEurToUsdt ? 'usdt' : 'eur')}`, 'success');
                    
                    // Mettre à jour l'affichage
                    updateBalances();
                    updateTransactions();
                    
                    // Réinitialiser les champs
                    fromAmount.value = '0';
                    toAmount.value = '0';
                    feeAmount.textContent = isEurToUsdt ? '€0,00' : '0,00 USDT';
                    netAmount.textContent = isEurToUsdt ? '0,00 USDT' : '€0,00';
                    
                    // Revenir à l'accueil après un délai
                    setTimeout(() => {
                        showPage('home');
                    }, 1500);
                } else {
                    showNotification(result.message, 'error');
                }
            });
            
            // Mettre à jour le calcul quand le taux change
            setInterval(() => {
                if (document.getElementById('swappPage').classList.contains('active')) {
                    updateExchangeCalculation();
                }
            }, 5000);
            
            // ============================================
            // DÉCONNEXION
            // ============================================
            
            document.getElementById('logoutButton').addEventListener('click', function() {
                if (confirm('Voulez-vous vraiment vous déconnecter ?')) {
                    // Déconnecter l'utilisateur
                    db.logout();
                    
                    // Masquer toutes les pages
                    pages.forEach(page => {
                        page.classList.remove('active');
                    });
                    
                    // Afficher l'écran de connexion
                    loginScreen.style.display = 'flex';
                    loginScreen.classList.add('fade-in');
                    
                    // Réinitialiser les champs
                    document.getElementById('loginEmail').value = '';
                    document.getElementById('loginPassword').value = '';
                    
                    showNotification('Déconnexion réussie', 'success');
                }
            });
            
            // ============================================
            // GRAPHIQUE CRYPTO
            // ============================================
            
            function initChart() {
                const ctx = document.getElementById('cryptoChart').getContext('2d');
                
                if (cryptoChart) {
                    cryptoChart.destroy();
                }
                
                // Données simulées pour le graphique
                const basePrice = db.exchangeRate;
                const data = [];
                for (let i = 0; i < 24; i++) {
                    const variation = (Math.random() - 0.5) * 0.02;
                    data.push(basePrice * (1 + variation));
                }
                
                cryptoChart = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: Array.from({length: 24}, (_, i) => `${i}h`),
                        datasets: [{
                            label: 'USDT',
                            data: data,
                            borderColor: '#66ff99',
                            backgroundColor: 'rgba(102, 255, 153, 0.1)',
                            borderWidth: 3,
                            fill: true,
                            tension: 0.4,
                            pointBackgroundColor: '#66ff99',
                            pointRadius: 2,
                            pointHoverRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                mode: 'index',
                                intersect: false,
                                backgroundColor: 'rgba(26, 29, 78, 0.9)',
                                titleColor: '#a0a5d6',
                                bodyColor: '#ffffff',
                                borderColor: '#5d00ff',
                                borderWidth: 1,
                                callbacks: {
                                    label: function(context) {
                                        return `USDT: $${context.parsed.y.toFixed(4)}`;
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: {
                                    display: false,
                                    drawBorder: false
                                },
                                ticks: {
                                    color: '#a0a5d6',
                                    maxTicksLimit: 8
                                }
                            },
                            y: {
                                grid: {
                                    color: 'rgba(160, 165, 214, 0.1)',
                                    drawBorder: false
                                },
                                ticks: {
                                    color: '#a0a5d6',
                                    callback: function(value) {
                                        return '$' + value.toFixed(2);
                                    }
                                },
                                suggestedMin: basePrice * 0.98,
                                suggestedMax: basePrice * 1.02
                            }
                        },
                        interaction: {
                            intersect: false,
                            mode: 'nearest'
                        }
                    }
                });
                
                // Mettre à jour le graphique périodiquement
                setInterval(() => {
                    if (cryptoChart && document.getElementById('portefeuillePage').classList.contains('active')) {
                        const newPrice = db.simulatePriceChange();
                        cryptoChart.data.datasets[0].data.push(newPrice);
                        cryptoChart.data.datasets[0].data.shift();
                        cryptoChart.update('none');
                        
                        // Mettre à jour l'affichage du prix
                        document.getElementById('usdtPrice').textContent = `$${newPrice.toFixed(2)}`;
                        updateBalances();
                    }
                }, 10000);
            }
        });
    </script>
</body>
</html>
